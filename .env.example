# Copy to .env and fill in. Never commit .env.

# Planner provider: "anthropic" (default) or "ollama" for local inference.
MODEL_PROVIDER=anthropic

# Anthropic — required only when MODEL_PROVIDER=anthropic.
# Tools degrade to deterministic stubs when this is unset, so the demo still runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama — used only when MODEL_PROVIDER=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# SQLite database path (runs, plans, steps, audit). Recreated by `make seed`.
DB_PATH=data/orchestrator.db
